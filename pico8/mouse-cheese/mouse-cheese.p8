function seed_for(n)
 local p=(n-1)*4+1
 local value=0
 for i=p,p+3 do
  local digit=ord(sub(campaign_data,i,i))
  if digit>=48 and digit<=57 then digit-=48 else digit-=87 end
  value=value*16+digit
 end
 return value
end

function rnext()
 rnd=bxor(rnd,shl(rnd,7))
 rnd=bxor(rnd,lshr(rnd,9))
 rnd=bxor(rnd,shl(rnd,8))
 rnd=band(rnd,0xffff)
 if rnd==0 then rnd=0xace1 end
 return rnd
end

function pick(n)
 return rnext()%n+1
end

function cell_at(x,y)
 return y*cols+x
end

function xy(c)
 return c%cols,flr(c/cols)
end

function edge_key(a,b)
 if a>b then a,b=b,a end
 return a..":"..b
end

function is_edge(a,b)
 return edges[edge_key(a,b)]
end

function join(a,b)
 edges[edge_key(a,b)]=true
end

function nbs(c)
 local x,y=xy(c)
 local t={}
 if x>0 then add(t,c-1) end
 if x<cols-1 then add(t,c+1) end
 if y>0 then add(t,c-cols) end
 if y<rows-1 then add(t,c+cols) end
 return t
end

function degree(c)
 local d=0
 for n in all(nbs(c)) do
  if present[n] and is_edge(c,n) then d+=1 end
 end
 return d
end

function choose_band()
 for b in all(bands) do
  if level<=b[1] then
   cols=b[2] rows=b[3] cell_size=b[4] detail_tier=b[5]
   loop_count=b[6] omission_percent=b[7]
   shape_chunks=b[8] max_chunk_depth=b[9]
   return
  end
 end
end

function build_maze()
 choose_band()
 rnd=seed_for(level)
 cells={} edges={} present={} cutout={}
 local count=cols*rows
 for c=0,count-1 do present[c]=true cutout[c]=false end
 for chunk=1,shape_chunks do
  local side=pick(4)-1
  local along=side<2 and rows or cols
  local span=pick(max(1,min(3,flr(along/3))))
  local depth=pick(max_chunk_depth)
  local first=pick(along-span+1)-1
  for position=first,first+span-1 do
   for inset=0,depth-1 do
    local x,y
    if side==0 then x=inset y=position
    elseif side==1 then x=cols-1-inset y=position
    elseif side==2 then x=position y=inset
    else x=position y=rows-1-inset end
    local cell=cell_at(x,y)
    present[cell]=false cutout[cell]=true
   end
  end
 end
 local active={}
 for c=0,count-1 do if present[c] then add(active,c) end end
 start_cell=active[pick(#active)]
 local seen={[start_cell]=true}
 local stack={start_cell}
 while #stack>0 do
  local here=stack[#stack]
  local choices={}
  for n in all(nbs(here)) do if present[n] and not seen[n] then add(choices,n) end end
  if #choices==0 then deli(stack,#stack)
  else
   local next=choices[pick(#choices)]
   seen[next]=true join(here,next) add(stack,next)
  end
 end
 local closed={}
 for c in all(active) do
  for n in all(nbs(c)) do
   if present[n] and c<n and not is_edge(c,n) then add(closed,{c,n}) end
  end
 end
 for i=1,min(loop_count,#closed) do
  local index=pick(#closed)
  join(unpack(closed[index]))
  deli(closed,index)
 end
 local leaves={}
 for c=0,count-1 do if present[c] and c!=start_cell and degree(c)==1 then add(leaves,c) end end
 local omit=min(flr(count*omission_percent/100),max(0,#leaves-1))
 for i=1,omit do
  local index=pick(#leaves)
  present[leaves[index]]=false
  deli(leaves,index)
 end
 local distances=bfs(start_cell)
 local far=-1
 local farthest={}
 for c=0,count-1 do
  local distance=distances[c]
  if distance!=nil then
   if distance>far then far=distance farthest={c}
   elseif distance==far then add(farthest,c) end
  end
 end
 goal_cell=farthest[pick(#farthest)]
 mouse_cell=start_cell
 facing=0
 path={}
 build_terrain_noise()
 board_dirty=true
end

function bfs(from)
 local dist={[from]=0}
 local queue={from}
 local at=1
 while at<=#queue do
  local c=queue[at] at+=1
  for n in all(nbs(c)) do
   if present[n] and is_edge(c,n) and dist[n]==nil then
    dist[n]=dist[c]+1 add(queue,n)
   end
  end
 end
 return dist
end

function make_hint()
 local prev={[mouse_cell]=mouse_cell}
 local queue={mouse_cell}
 local at=1
 while at<=#queue do
  local c=queue[at] at+=1
  if c==goal_cell then break end
  for n in all(nbs(c)) do
   if present[n] and is_edge(c,n) and prev[n]==nil then prev[n]=c add(queue,n) end
  end
 end
 path={}
 local c=goal_cell
 while c!=mouse_cell and prev[c] do add(path,c) c=prev[c] end
 path=reverse(path)
 hint=90
end

function reverse(t)
 local out={}
 for i=#t,1,-1 do add(out,t[i]) end
 return out
end

function try_move(dx,dy)
 local x,y=xy(mouse_cell)
 local nx,ny=x+dx,y+dy
 if nx<0 or ny<0 or nx>=cols or ny>=rows then return false end
 local target=cell_at(nx,ny)
 if present[target] and is_edge(mouse_cell,target) then
  if dx<0 then facing=2 elseif dx>0 then facing=3 elseif dy<0 then facing=1 else facing=0 end
  move_from=mouse_cell
  move_to=target
  -- A deliberate 12-frame slide is slow enough to read at 60fps, while the
  -- repeat timer below is cleared so held directions chain with no dead beat.
  move_ticks=12
  input_wait=0
  return true
 end
 return false
end

function held_direction()
 if btn(0) then return -1,0 end
 if btn(1) then return 1,0 end
 if btn(2) then return 0,-1 end
 if btn(3) then return 0,1 end
 return 0,0
end

function skip_levels(amount)
 level=min(100,level+amount)
 save_progress()
 build_maze()
end

function update_play()
 if celebrate>0 then
  celebrate-=1
  if celebrate==0 then level=min(100,level+1) solved=max(solved,level-1) save_progress() build_maze() end
  return
 end
 if hint>0 then hint-=1 end
 -- A shows a hint; B always returns home without affecting the maze.
 if btn(2) and btnp(5) then skip_levels(1) return end
 if btn(3) and btnp(5) then skip_levels(10) return end
 if btnp(4) then make_hint() return end
 if btnp(5) then
  screen="title" title_dirty=true hold=0 reset_latched=true
  return
 end
 if move_ticks>0 then
  move_ticks-=1
  if move_ticks==0 then
   mouse_cell=move_to
   if mouse_cell==goal_cell then
     celebrate=victory_frames sfx(0)
   else
    -- Start the held next direction in this same update: no cell-boundary
    -- pause and therefore no stop-and-lunge rhythm.
    local dx,dy=held_direction()
    if dx!=0 or dy!=0 then try_move(dx,dy) end
   end
  end
  return
 end
 local dx,dy=held_direction()
 if dx!=0 or dy!=0 then
  if input_wait<=0 then try_move(dx,dy) input_wait=5 else input_wait-=1 end
 else input_wait=0 end
end

function save_progress()
 dset(0,1) dset(1,level) dset(2,solved) dset(3,campaign_generator_version)
end

function load_progress()
 if dget(0)!=1 or dget(3)!=campaign_generator_version then
  level=1 solved=0 save_progress()
 else
  level=mid(1,flr(dget(1)),100)
  solved=max(0,flr(dget(2)))
 end
end

function _init()
 palt(0,true)
 load_progress()
 build_maze()
end

function _update60()
 tick+=1
 if reset_notice>0 then reset_notice-=1 if screen=="title" then title_dirty=true end end
 if screen=="title" then
  if btnp(4) then screen="play" end
  if not btn(5) then
   if hold>0 then title_dirty=true end
   hold=0 reset_latched=false
  elseif not reset_latched then
   hold+=1
  end
  if hold>0 then title_dirty=true end
  if hold>=90 then
   level=1 solved=0 save_progress() build_maze()
   hold=0 reset_latched=true reset_notice=75 title_dirty=true
  end
 elseif screen=="play" then update_play()
 elseif screen=="pause" then
  if btnp(4) then screen="play" end
  if btnp(5) then screen="title" title_dirty=true hold=0 reset_latched=true end
 end
end

function board_box()
 local size=cell_size
 -- The old logical-cell border consumed 14-18 physical pixels on early
 -- boards. A thin physical hedge frame lets the playable grid reach the edge.
 local border=max(2,flr(size/4))
 local w=cols*size+border*2
 local h=rows*size+border*2
 return flr((128-w)/2),flr((128-h)/2),size,border
end

function draw_mouse_at(ox,oy,s,border)
 local x,y=xy(mouse_cell)
 local px,py=ox+border+x*s,oy+border+y*s
 if move_ticks>0 then
  local tx,ty=xy(move_to)
  local progress=1-move_ticks/12
  px+=(tx-x)*s*progress
  py+=(ty-y)*s*progress
 end
 draw_mouse(px,py,s)
end

function draw_mouse(x,y,s)
 local sizes={14,9,7,5}
 local size=sizes[detail_tier]
 local ys={0,16,32,40}
 local run_ys={80,96,108,116}
 local source_y=ys[detail_tier]
 if move_ticks>0 and flr(tick/4)%2==1 then source_y=run_ys[detail_tier] end
 local draw_size=max(3,flr(s*.72))
 sspr(facing*(size+2),source_y,size,size,x+flr((s-draw_size)/2),y+flr((s-draw_size)/2),draw_size,draw_size)
end

function draw_cheese(x,y,s)
 local sizes={14,9,7,5}
 local size=sizes[detail_tier]
 local ys={0,16,32,40}
 local draw_size=max(3,flr(s*.58))
 sspr(64,ys[detail_tier],size,size,x+flr((s-draw_size)/2),y+flr((s-draw_size)/2),draw_size,draw_size)
end

hedge_noise_seed=0
ground_noise_seed=0

function build_terrain_noise()
 hedge_noise_seed=seed_for(level)+level*97
 ground_noise_seed=seed_for(level)+level*211
end

function noise_hash(x,y,seed)
 return (x*157+y*113+x*y*19+seed*37)%256
end

function value_noise(x,y,seed,scale)
 local gx,gy=flr(x/scale),flr(y/scale)
 local tx,ty=(x%scale)/scale,(y%scale)/scale
 local a=noise_hash(gx,gy,seed)
 local b=noise_hash(gx+1,gy,seed)
 local c=noise_hash(gx,gy+1,seed)
 local d=noise_hash(gx+1,gy+1,seed)
 local top=a+(b-a)*tx
 local bottom=c+(d-c)*tx
 return top+(bottom-top)*ty
end

function layered_noise(x,y,seed,low_scale,high_scale)
 local low=value_noise(x,y,seed,low_scale)
 local high=value_noise(x,y,seed+197,high_scale)
 return low*.58+high*.42
end

function shade_terrain(ox,oy,right,bottom)
 -- Quantizing the sample coordinates to two-pixel blocks keeps the contours
 -- deliberately pixelated while the low-frequency fields make them cloudlike.
 for y=oy,bottom do
  for x=ox,right do
   local base=pget(x,y)
   local qx,qy=flr(x/2)*2,flr(y/2)*2
   if base==11 and layered_noise(qx,qy,hedge_noise_seed,36,6)<132 then
    pset(x,y,3)
   elseif base==8 and layered_noise(qx,qy,ground_noise_seed,28,5)<118 then
    pset(x,y,12)
   end
  end
 end
end

function use_game_palette()
 pal()
 pal(3,139,1)
 pal(8,132,1)
 pal(12,133,1)
end

function use_title_palette()
 pal()
end

function cache_board()
 -- The map and lower user-RAM blocks form one complete 8KB framebuffer cache.
 memcpy(0x2000,0x6000,0x1000)
 memcpy(0x4300,0x7000,0x1000)
end

function restore_board()
 memcpy(0x6000,0x2000,0x1000)
 memcpy(0x7000,0x4300,0x1000)
end

function queue_hedge_run(spans,axis,fixed,first,last,kind)
 local at=first
 while at<=last do
  local length=min(last-at+1,9+noise_hash(fixed,at,hedge_noise_seed)%8)
  if length>=7 and noise_hash(at,fixed,hedge_noise_seed+41)%100<24 then
   local delta=noise_hash(at,fixed,hedge_noise_seed+83)%2*2-1
   add(spans,{axis,fixed,at,at+length-1,kind,delta})
  end
  at+=length
 end
end

function collect_hedge_spans(ox,oy,right,bottom)
 local spans={}
 for x=ox+1,right-2 do
  local first=nil
  local kind=0
  for y=oy+1,bottom-1 do
   local a,b=pget(x,y),pget(x+1,y)
   local next_kind=(a==11 and b==8) and 1 or ((a==8 and b==11) and -1 or 0)
   if next_kind!=kind then
    if kind!=0 then queue_hedge_run(spans,0,x,first,y-1,kind) end
    first=next_kind!=0 and y or nil
    kind=next_kind
   end
  end
  if kind!=0 then queue_hedge_run(spans,0,x,first,bottom-1,kind) end
 end
 for y=oy+1,bottom-2 do
  local first=nil
  local kind=0
  for x=ox+1,right-1 do
   local a,b=pget(x,y),pget(x,y+1)
   local next_kind=(a==11 and b==8) and 1 or ((a==8 and b==11) and -1 or 0)
   if next_kind!=kind then
    if kind!=0 then queue_hedge_run(spans,1,y,first,x-1,kind) end
    first=next_kind!=0 and x or nil
    kind=next_kind
   end
  end
  if kind!=0 then queue_hedge_run(spans,1,y,first,right-1,kind) end
 end
 return spans
end

function sculpt_hedges(spans)
 for span in all(spans) do
  local axis,fixed,first,last,kind,delta=unpack(span)
  for along=first+2,last-2 do
   local hx,hy,gx,gy
   if axis==0 then
    hx=kind==1 and fixed or fixed+1
    gx=kind==1 and fixed+1 or fixed
    hy=along gy=along
   else
    hy=kind==1 and fixed or fixed+1
    gy=kind==1 and fixed+1 or fixed
    hx=along gx=along
   end
   local dx,dy=gx-hx,gy-hy
   if delta<0 and pget(hx,hy)==11 and pget(hx-dx,hy-dy)==11 then
    pset(hx,hy,8)
   elseif delta>0 and pget(gx,gy)==8 and pget(gx+dx,gy+dy)==8 then
    pset(gx,gy,11)
   end
  end
 end
end

function stamp_surface(x,y,ground)
 local color=pget(x,y)
 return ground and (color==8 or color==12) or (color==11 or color==3)
end

function stamp_fits(sprite,x,y,ground)
 local source_x=(sprite%16)*8
 local source_y=flr(sprite/16)*8
 for sy=0,7 do
  for sx=0,7 do
   if sget(source_x+sx,source_y+sy)!=0 and not stamp_surface(x+sx,y+sy,ground) then return false end
  end
 end
 return true
end

function stamp_hash(x,y,seed)
 local mixed=noise_hash(x+seed%17,y+flr(seed/17),seed)
 return noise_hash(y+mixed,x*3+mixed,seed+71)
end

function draw_environment_stamps(ox,oy,s,border)
 for cell=0,cols*rows-1 do
  local gx,gy=xy(cell)
  local h=noise_hash(gx,gy,seed_for(level)+311)
  local px=ox+border+gx*s+flr((s-8)/2)
  local py=oy+border+gy*s+flr((s-8)/2)
  local sprite=114+h%4
  if present[cell] and cell!=start_cell and cell!=goal_cell and h%11==0 and stamp_fits(sprite,px,py,true) then
   spr(sprite,px,py)
  end
 end
 local right=ox+cols*s+border*2-1
 local bottom=oy+rows*s+border*2-1
 for gy=oy+1,bottom-8,9 do
  for gx=ox+1,right-8,9 do
   local h=stamp_hash(gx,gy,hedge_noise_seed+419)
   local fx=mid(ox,gx+h%5-2,right-7)
   local fy=mid(oy,gy+flr(h/5)%5-2,bottom-7)
   local sprite=118+flr(stamp_hash(gx,gy,h)/32)%4
   if h<104 and stamp_fits(sprite,fx,fy,false) then
    spr(sprite,fx,fy)
   end
  end
 end
end

function vary_cutout_edge(bx,by,hx,hy,ax,ay,s,h)
 local length=2+h%min(4,max(1,s-3))
 local offset=1+flr(h/7)%max(1,s-length-1)
 for step=offset,offset+length-1 do
  local blue_x,blue_y=bx+ax*step,by+ay*step
  local hedge_x,hedge_y=hx+ax*step,hy+ay*step
  local hedge=pget(hedge_x,hedge_y)
  if pget(blue_x,blue_y)==1 and (hedge==11 or hedge==3) then
   if h%2==0 then pset(blue_x,blue_y,hedge)
   else pset(hedge_x,hedge_y,1) end
  end
 end
end

function vary_cutout_boundaries(ox,oy,s,border)
 for cell=0,cols*rows-1 do
  local x,y=xy(cell)
  local left=ox+border+x*s
  local top=oy+border+y*s
  if x<cols-1 and cutout[cell]!=cutout[cell+1] then
   local left_cut=cutout[cell]
   local bx=left_cut and left+s-1 or left+s
   local hx=left_cut and left+s or left+s-1
   vary_cutout_edge(bx,top,hx,top,0,1,s,noise_hash(cell,cell+1,hedge_noise_seed+557))
  end
  if y<rows-1 and cutout[cell]!=cutout[cell+cols] then
   local top_cut=cutout[cell]
   local by=top_cut and top+s-1 or top+s
   local hy=top_cut and top+s or top+s-1
   vary_cutout_edge(left,by,left,hy,1,0,s,noise_hash(cell,cell+cols,hedge_noise_seed+613))
  end
 end
end

function draw_static_board()
 local ox,oy,s,border=board_box()
 rectfill(0,0,127,127,1)
 local right=ox+cols*s+border*2-1
 local bottom=oy+rows*s+border*2-1
 rectfill(ox,oy,right,bottom,11)
 rect(ox,oy,right,bottom,3)
 -- Round the visible arena corners back into the blue surround.
 pset(ox,oy,1) pset(right,oy,1) pset(ox,bottom,1) pset(right,bottom,1)
 if border>=3 then
  pset(ox+1,oy,1) pset(ox,oy+1,1) pset(right-1,oy,1) pset(right,oy+1,1)
  pset(ox+1,bottom,1) pset(ox,bottom-1,1) pset(right-1,bottom,1) pset(right,bottom-1,1)
 end
 for c=0,cols*rows-1 do
  local x,y=xy(c)
  local px,py=ox+border+x*s,oy+border+y*s
  if present[c] then
   local inset=max(1,flr(s/5))
   rectfill(px+inset,py+inset,px+s-inset-1,py+s-inset-1,8)
   if x<cols-1 and present[c+1] and is_edge(c,c+1) then
    rectfill(px+s/2,py+inset,px+s+inset-1,py+s-inset-1,8)
   end
   if y<rows-1 and present[c+cols] and is_edge(c,c+cols) then
    rectfill(px+inset,py+s/2,px+s-inset-1,py+s+inset-1,8)
   end
  end
 end
 local hedge_spans=collect_hedge_spans(ox,oy,right,bottom)
 sculpt_hedges(hedge_spans)
 shade_terrain(ox,oy,right,bottom)
 for cell=0,cols*rows-1 do
  if cutout[cell] then
   local x,y=xy(cell)
   local left=ox+border+x*s
   local top=oy+border+y*s
   local cut_right=left+s-1
   local cut_bottom=top+s-1
   if x==0 then left=ox end
   if y==0 then top=oy end
   if x==cols-1 then cut_right=right end
   if y==rows-1 then cut_bottom=bottom end
   rectfill(left,top,cut_right,cut_bottom,1)
  end
 end
 vary_cutout_boundaries(ox,oy,s,border)
 draw_environment_stamps(ox,oy,s,border)
end

function rounded_box(x,y,w,h,color)
 local r=max(1,min(5,flr(min(w,h)/4)))
 rectfill(x+r,y,x+w-r-1,y+h-1,color)
 rectfill(x,y+r,x+w-1,y+h-r-1,color)
 circfill(x+r,y+r,r,color)
 circfill(x+w-r-1,y+r,r,color)
 circfill(x+r,y+h-r-1,r,color)
 circfill(x+w-r-1,y+h-r-1,r,color)
end

function victory_pop(age)
 if age<6 then return age/5*1.18 end
 if age<10 then return 1.18-(age-6)/4*.24 end
 if age<14 then return .94+(age-10)/4*.06 end
 return 1
end

function draw_victory_card()
 local age=victory_frames-celebrate
 if age<=0 then return end
 local pop=victory_pop(age)
 local w=max(2,flr(100*pop))
 local h=max(2,flr(82*pop*(.86+.14*min(pop,1))))
 local cx=64
 local cy=68-flr(4*min(pop,1))
 local x,y=flr(cx-w/2),flr(cy-h/2)
 rounded_box(x+2,y+3,w,h,0)
 rounded_box(x,y,w,h,15)
 if w>8 and h>8 then rounded_box(x+2,y+2,w-4,h-4,1) end
 if pop>.35 then
  local size=max(4,flr(42*pop))
  local bob=pop>.9 and flr(sin(tick/54)*2+sin(tick/91)) or 0
  local cheese_y=cy-flr(11*pop)+bob
  sspr(80,0,28,28,cx-flr(size/2),cheese_y-flr(size/2),size,size)
 end
 if pop>.72 then sspr(0,64,90,16,cx-45,cy+18,90,16) end
end

function draw_pieces()
 local ox,oy,s,border=board_box()
 local gx,gy=xy(goal_cell)
 if present[goal_cell] then draw_cheese(ox+border+gx*s,oy+border+gy*s,s) end
 if present[mouse_cell] then draw_mouse_at(ox,oy,s,border) end
 if hint>0 then
  local shown=min(#path,12,max(1,flr(#path/2)))
  local fade_colors={7,6,13,5,1}
  for i=1,shown do
   local c=path[i]
   local x,y=xy(c)
   local fade=(i-1)/max(1,shown-1)
   local color=fade_colors[1+flr(fade*(#fade_colors-1))]
   local px=ox+border+x*s+flr(s/2)
   local py=oy+border+y*s+flr(s/2)
   if i<=2 then circfill(px,py,1,color) else pset(px,py,color) end
  end
 end
 if celebrate>0 then draw_victory_card() end
end

function draw_board()
 use_game_palette()
 if board_dirty then
  draw_static_board()
  cache_board()
  board_dirty=false
 else
  restore_board()
 end
 draw_pieces()
end

function bubble_text(text,x,y,color)
 print(text,x-1,y,0)
 print(text,x+1,y,0)
 print(text,x,y-1,0)
 print(text,x,y+1,0)
 print(text,x,y,color)
end

function draw_title_scene()
 use_title_palette()
 cls(1)
 local x,y,p=0,0,1
 while p<#title_data do
  local n=ord(sub(title_data,p,p))-48
  local c=ord(sub(title_data,p+1,p+1))-48
  if n>9 then n-=39 end
  if c>9 then c-=39 end
  for i=1,n do pset(x,y,c) x+=1 if x==128 then x=0 y+=1 end end
  p+=2
 end
 rectfill(36,108,92,127,1)
 rectfill(38,109,90,125,3)
 bubble_text("level "..level,51,111,7)
 bubble_text("z play",53,118,7)
 if hold>0 then
  local progress=mid(0,flr(hold/90*48),48)
  rectfill(40,102,88,103,1)
  rectfill(40,102,40+progress,103,8)
  bubble_text("resetting",46,94,7)
 elseif reset_notice>0 then
  bubble_text("reset!",51,102,10)
 else
  bubble_text("hold b reset",42,102,7)
 end
end

function _draw()
 if screen=="title" then
  if title_dirty then draw_title_scene() title_dirty=false end
 elseif screen=="pause" then
  cls(1)
  draw_board()
  rectfill(28,48,100,80,1)
  print("paused",48,55,7)
  print("z: continue",37,65,11)
  print("x: title",43,72,6)
 else
  cls(1)
  draw_board()
  rectfill(0,0,11,7,1)
  print(""..level,3,1,7)
 end
end
