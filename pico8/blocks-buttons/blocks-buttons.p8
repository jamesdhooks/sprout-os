title_dirty=true

bw=8 bh=8 cs=16 bx=0 by=0
room_no=1 walls="" targets={} crates={} dead={}
px=2 py=2 facing=2 moves=0 pushes=0 card_age=0
move_t=-1 move_frames=8 move_from_x=0 move_from_y=0
moving_crate=0 crate_from_x=0 crate_from_y=0
undo=nil reset_hold=0 reset_done=false reset_armed=true
if dget(0)!=1 then
 for i=0,10 do dset(i,0) end dset(0,1) dset(1,1)
else room_no=mid(1,flr(dget(1)),#blocks_campaign) end

function fields(text)
 local out={} local start=1
 for i=1,#text+1 do if i>#text or sub(text,i,i)=="|" then add(out,sub(text,start,i-1)) start=i+1 end end
 return out
end

function point(hex)
 local n=tonum("0x"..hex)
 return {n%8,flr(n/8)}
end

function points(text)
 local out={}
 for i=1,#text,2 do add(out,point(sub(text,i,i+1))) end
 return out
end

function copy_points(values)
 local out={} for v in all(values) do add(out,{v[1],v[2]}) end return out
end

function load_room(number,restore)
 room_no=mid(1,number,#blocks_campaign)
 local f=fields(blocks_campaign[room_no])
 walls=f[1] local p=point(f[2]) px=p[1] py=p[2]
 crates=points(f[3]) targets=points(f[4]) dead=points(f[5])
 facing=2 moves=0 pushes=0 move_t=-1 moving_crate=0 undo=nil
 arc_screen="play" card_age=0 title_dirty=true
 if restore and dget(0)==1 and dget(1)==room_no and dget(6)==#crates then
  px=dget(2) py=dget(3) moves=dget(4) pushes=dget(5)
  for i=1,#crates do local n=dget(6+i) crates[i]={n%8,flr(n/8)} end
 end
end

function save_room()
 dset(0,1) dset(1,room_no) dset(2,px) dset(3,py)
 dset(4,moves) dset(5,pushes) dset(6,#crates)
 for i=1,#crates do dset(6+i,crates[i][2]*8+crates[i][1]) end
end

function reset_campaign()
 for i=0,10 do dset(i,0) end
 dset(0,1) dset(1,1) room_no=1
 sfx(6)
end

function wall(x,y)
 return x<0 or y<0 or x>=bw or y>=bh or sub(walls,y*8+x+1,y*8+x+1)=="#"
end

function crate_at(x,y)
 for i=1,#crates do
  if crates[i][1]==x and crates[i][2]==y then return i end
 end
 return 0
end

function target_at(x,y)
 for t in all(targets) do if t[1]==x and t[2]==y then return true end end
 return false
end

function dead_at(x,y)
 for d in all(dead) do if d[1]==x and d[2]==y then return true end end
 return false
end

function room_solved()
 for t in all(targets) do if crate_at(t[1],t[2])==0 then return false end end
 return true
end

function deadlocked()
 for c in all(crates) do
  if not target_at(c[1],c[2]) and dead_at(c[1],c[2]) then return true end
 end
 return false
end

function move_player(dx,dy,face)
 facing=face
 if move_t>=0 then return end
 local nx=px+dx local ny=py+dy
 if wall(nx,ny) then sfx(2) return end
 local ci=crate_at(nx,ny)
 if ci>0 then
  local cx=nx+dx local cy=ny+dy
  if wall(cx,cy) or crate_at(cx,cy)>0 then sfx(2) return end
  undo={px,py,copy_points(crates),moves,pushes}
  moving_crate=ci crate_from_x=nx crate_from_y=ny
  crates[ci][1]=cx crates[ci][2]=cy pushes+=1
  sfx(target_at(cx,cy) and 1 or 0)
 else
  undo={px,py,copy_points(crates),moves,pushes}
 end
 move_from_x=px move_from_y=py move_t=0
 px=nx py=ny moves+=1
end

function finish_move()
 move_t=-1 moving_crate=0
 if room_solved() then
  dset(10,room_no) card_age=0 arc_begin_card(room_no==#blocks_campaign and "campaign" or "win",84) sfx(4)
 elseif deadlocked() then
  card_age=0 arc_begin_card("fail",32767) sfx(5)
 else save_room()
 end
end

function do_undo()
 if not undo then return end
 px=undo[1] py=undo[2] crates=undo[3] moves=undo[4] pushes=undo[5]
 undo=nil sfx(3) save_room()
end

function _update60()
 arc_tick()
 if qa_capture=="reset-holding" or qa_capture=="reset-cancelled" or qa_capture=="reset-complete" then return end
 if arc_screen=="title" then
  if not btn(5) then
   if reset_hold>0 and not reset_done then reset_hold=0 title_dirty=true end
   reset_armed=true
   if reset_done then reset_done=false reset_hold=0 title_dirty=true end
  elseif reset_armed and not reset_done then
   reset_hold+=1 title_dirty=true
   if reset_hold>=180 then reset_campaign() reset_done=true title_dirty=true end
  end
  if arc_pressed(4) and not btn(5) and not reset_done then load_room(room_no,true) end
 elseif arc_screen=="play" then
  if arc_pressed(5) then arc_screen="title" reset_armed=false reset_hold=0 title_dirty=true return end
  if move_t>=0 then
   move_t+=1
   if move_t>=move_frames then finish_move() end
  elseif arc_pressed(4) then do_undo()
  elseif arc_pressed(0) then move_player(-1,0,3)
  elseif arc_pressed(1) then move_player(1,0,1)
  elseif arc_pressed(2) then move_player(0,-1,0)
  elseif arc_pressed(3) then move_player(0,1,2) end
 else
  card_age+=1
  if arc_card_kind=="fail" then
   if arc_pressed(4) then reset_room()
   elseif arc_pressed(5) then arc_screen="title" end
  else
   local finished_kind=arc_card_kind
   if arc_update_card() then
   if finished_kind=="campaign" then arc_screen="title" reset_armed=false title_dirty=true
   else load_room(room_no+1,false) save_room() end
   end
  end
 end
end

function draw_title()
 local x,y,p=0,0,1
 while p<#title_data do
  local n=ord(sub(title_data,p,p))-48
  local c=ord(sub(title_data,p+1,p+1))-48
  if n>9 then n-=39 end
  if c>9 then c-=39 end
  for i=1,n do pset(x,y,c) x+=1 if x==128 then x=0 y+=1 end end
  p+=2
 end
 rectfill(2,108,125,126,1)
 print("room "..room_no.." / 30",6,111,7)
 if reset_done then print("reset!",92,119,10)
 elseif reset_hold>0 then
  print("resetting",72,111,7)
  rect(71,120,121,124,5) rectfill(72,121,72+flr(reset_hold/180*48),123,12)
 else print("hold b reset",72,119,6) end
end

function draw_floor(x,y,gx,gy)
 local sx=((gx*19+gy*31)%5==0) and 96 or 0
 sspr(sx,48,16,16,x,y,cs,cs)
end

function draw_wall(x,bottom)
 sspr(16,48,16,16,x,bottom-16,16,16)
end

function draw_button(cx,cy,down)
 sspr(down and 48 or 32,48,16,16,cx-8,cy-8,16,16)
end

function draw_crate(cx,bottom,solved)
 sspr(solved and 80 or 64,48,16,16,cx-8,bottom-16,16,16)
end

function draw_robot_at(cx,bottom,face,pushing)
 local row=face==2 and 0 or face==0 and 1 or 2
 local frame=1
 if pushing then frame=4
 elseif move_t>=0 then frame=min(3,flr(move_t*4/move_frames)) end
 sspr(frame*16,row*16,16,16,cx-8,bottom-16,16,16,face==1,false)
end

function draw_play()
 cls(5)
 -- The floor owns the exact grid. Raised objects share a bottom anchor and
 -- are painted by row, allowing their upper art to overlap the row behind.
 for y=0,bh-1 do for x=0,bw-1 do
  draw_floor(bx+x*cs,by+y*cs,x,y)
 end end
 for t in all(targets) do
  draw_button(bx+t[1]*cs+8,by+t[2]*cs+8,crate_at(t[1],t[2])>0)
 end
 local p=move_t>=0 and min(1,move_t/move_frames) or 1
 local rx=px local ry=py
 if move_t>=0 then
  rx=move_from_x+(px-move_from_x)*p
  ry=move_from_y+(py-move_from_y)*p
 end
 for row=0,bh-1 do
  for x=0,bw-1 do
   if wall(x,row) then draw_wall(bx+x*cs,by+(row+1)*cs) end
  end
  for i=1,#crates do
   local c=crates[i] local cx=c[1] local cy=c[2]
   if i==moving_crate then
    cx=crate_from_x+(c[1]-crate_from_x)*p
    cy=crate_from_y+(c[2]-crate_from_y)*p
   end
   if cy>=row and cy<row+1 then
    draw_crate(bx+cx*cs+8,by+cy*cs+16,target_at(c[1],c[2]))
   end
  end
  if ry>=row and ry<row+1 then
   draw_robot_at(bx+rx*cs+8,by+ry*cs+16,facing,moving_crate>0)
  end
 end
end

function draw_card()
 draw_play()
 rectfill(0,0,127,127,1)
 local s=max(.05,arc_pop_scale(card_age))
 local w=flr(104*s) local h=flr(78*s)
 local x=64-flr(w/2) local y=64-flr(h/2)
 arc_panel(x,y,w,h,arc_card_kind=="win" and 13 or 2,arc_card_kind=="win" and 10 or 8)
 if s>.72 then
  if arc_card_kind=="win" or arc_card_kind=="campaign" then
   -- large top-down solved crate with a shallow front face
   rectfill(49,42,79,68,10)
   rectfill(49,69,79,76,9)
   rect(49,42,79,76,1)
   line(55,47,73,64,7) line(73,47,55,64,7)
   for i=0,9 do
    local a=i/10 local r=26+sin((arc_ticks+i)/9)*4
    pset(64+cos(a)*r,53+sin(a)*r,(i%4)+8)
   end
   arc_center_text(arc_card_kind=="campaign" and "workshop done!" or "pressed!",82,7)
   arc_center_text(arc_card_kind=="campaign" and "30 rooms!" or "next room",94,7)
  else
   arc_center_text("crate stuck",48,8)
   arc_center_text("try another way",65,7)
   arc_center_text("z retry   x back",88,6)
  end
 end
end

function _draw()
 if arc_screen=="title" then
  if title_dirty then draw_title() title_dirty=false end
 else
  title_dirty=true
  if arc_screen=="play" then draw_play() else draw_card() end
 end
end

if qa_capture=="gameplay" then
 load_room(10,false)
elseif qa_capture=="win" then
 load_room(1,false) crates=copy_points(targets) card_age=18 arc_begin_card("win",32767)
elseif qa_capture=="fail" then
 load_room(12,false) card_age=18 arc_begin_card("fail",32767)
elseif qa_capture=="undo" then
 load_room(4,false) undo={px,py,copy_points(crates),0,0}
elseif qa_capture=="push" then
 load_room(10,false)
 facing=2 move_from_x=5 move_from_y=2 px=5 py=3 move_t=4
 moving_crate=2 crate_from_x=5 crate_from_y=3 crates[2][1]=5 crates[2][2]=4
elseif qa_capture=="late-gameplay" then
 load_room(29,false)
elseif qa_capture=="reset-holding" then
 arc_screen="title" reset_hold=110 reset_done=false title_dirty=true
elseif qa_capture=="reset-cancelled" then
 arc_screen="title" reset_hold=0 reset_done=false title_dirty=true
elseif qa_capture=="reset-complete" then
 arc_screen="title" reset_hold=180 reset_done=true title_dirty=true
end

